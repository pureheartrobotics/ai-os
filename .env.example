# ---------- DeepSeek（默认：大模型 + 语音识别 + 语音合成都用它，只填这一个 Key 即可） ----------
# 在 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-xxx

# ---------- 大模型（默认 DeepSeek，也可换成任意 OpenAI 兼容接口） ----------
# LLM_API_KEY 不填时使用 DEEPSEEK_API_KEY
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# DeepSeek 思考模式：disabled 响应更快，enabled 规划复杂任务更稳
LLM_THINKING=disabled

# ---------- 视觉模型（可选，留空则不启用"看屏幕"能力） ----------
# 不填 VISION_API_KEY / VISION_BASE_URL 时沿用上面的 LLM 配置
# 例：通义 qwen-vl-max（VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1）
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=

# ---------- 语音识别 ----------
# deepseek：DeepSeek ASR（默认）
# openai：任意 OpenAI 兼容的 /audio/transcriptions 接口，需同时配置下面三项
STT_PROVIDER=deepseek
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_LANGUAGE=zh

# ---------- 语音合成 ----------
# deepseek：DeepSeek TTS（默认，音色 stella 女声 / tide 男声）
# local：Windows 自带语音，离线可用
TTS_PROVIDER=deepseek
TTS_VOICE=stella
# 仅 local 模式有效
TTS_RATE=200

# ---------- 交互 ----------
# 唤醒词，留空则每句话都当作指令
WAKE_WORD=小爱
# local：本地离线识别唤醒词，唤醒前的声音不上传（需 pip install "ai-os-desktop[wake]" 并运行 python -m ai_os.wake 下载模型）
# cloud：每句话都发到云端识别，再检查开头是否是唤醒词
# local 不可用时自动退回 cloud
WAKE_ENGINE=local
# 本地唤醒灵敏度，越小越容易唤醒（也越容易误唤醒）
WAKE_THRESHOLD=0.25
# 唤醒后多少秒内无需再说唤醒词
WAKE_SESSION_SECONDS=30
# 麦克风音量阈值（int16 RMS），环境嘈杂时调高
VAD_THRESHOLD=500
# 说完话后静音多久判定为一句结束（毫秒）
VAD_SILENCE_MS=800
# 单个指令最多执行多少步
MAX_STEPS=25
